{
  "name": "desktop-destroyer",
  "version": "0.2.0",
  "description": "Desktop Destroyer for the web — an interactive overlay that lets visitors physically demolish any page. Real rigid-body debris, Voronoi shattering, DOM-aware demolition, fire that spreads, black holes, and a WebGL bloom pass.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src",
    "benchmarks",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "benchmark": "bun run build && node scripts/benchmark.mjs",
    "benchmark:low-end": "bun run build && node scripts/benchmark.mjs --cpu 6",
    "memory:check": "bun run build && node scripts/benchmark.mjs --scenarios idle --duration 250 --warmup 100 --leak-cycles 80",
    "prepublishOnly": "tsup"
  },
  "keywords": [
    "canvas",
    "desktop-destroyer",
    "easter-egg",
    "particles",
    "fire",
    "physics",
    "rigid-body",
    "destruction",
    "voronoi",
    "webgl",
    "bloom",
    "interactive",
    "react"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "html-to-image": "^1.11.13"
  }
}
