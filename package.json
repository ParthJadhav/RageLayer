{
  "name": "desktop-destroyer",
  "version": "0.3.0",
  "description": "Desktop Destroyer for the web — an interactive overlay that lets visitors physically demolish any page. Real rigid-body debris, Voronoi shattering, DOM-aware demolition, fire that spreads, black holes, and a WebGL bloom pass.",
  "license": "MIT",
  "author": "Parth Jadhav <jadhavparth99@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ParthJadhav/desktop-destroyer.git"
  },
  "homepage": "https://github.com/ParthJadhav/desktop-destroyer#readme",
  "bugs": "https://github.com/ParthJadhav/desktop-destroyer/issues",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.3.9",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:package": "publint && attw --pack . --profile esm-only",
    "check": "bun run typecheck && bun run lint && bun test && bun run build && bun run check:package",
    "benchmark": "bun run build && node scripts/benchmark.mjs",
    "benchmark:low-end": "bun run build && node scripts/benchmark.mjs --cpu 6",
    "profile:effects": "bun run build && node scripts/profile-effects.mjs --effects hammer,gun,flamethrower,water,chainsaw,paintball,demolition,rocket,lightning,freeze,blackhole,bugs,broom",
    "profile:effects:low-end": "bun run build && node scripts/profile-effects.mjs --effects hammer,gun,flamethrower,water,chainsaw,paintball,demolition,rocket,lightning,freeze,blackhole,bugs,broom --cpu 6",
    "memory:check": "bun run build && node scripts/benchmark.mjs --scenarios idle --duration 250 --warmup 100 --leak-cycles 80",
    "screenshots": "bun run build && node scripts/screenshots.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "prepublishOnly": "tsdown"
  },
  "keywords": [
    "canvas",
    "desktop-destroyer",
    "easter-egg",
    "particles",
    "fire",
    "physics",
    "rigid-body",
    "destruction",
    "voronoi",
    "webgl",
    "bloom",
    "interactive",
    "react"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.4.0",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.29.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "publint": "^0.3.14",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "html-to-image": "^1.11.13"
  }
}
